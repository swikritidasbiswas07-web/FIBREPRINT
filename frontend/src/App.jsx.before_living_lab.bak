
import React, {useEffect,useMemo,useState} from 'react';
import MicroscopeExplorer from './MicroscopeExplorer';
import './model-status.css';
import MaterialPassport from './MaterialPassport';
import ResearchResults from './ResearchResults';
import ResearchStatus from './ResearchStatus';
import ExternalEvidence from './ExternalEvidence';

import { ArrowUpRight, ArrowRight, BookOpen, Check, CircleHelp, Droplets, FlaskConical, Layers3, Menu, Microscope, MoveRight, SlidersHorizontal, Upload, X, Lightbulb, RotateCcw, ArrowDown, Search, Sparkles, BadgeCheck, Filter, Info } from 'lucide-react';

const FALLBACK_SOURCES=[
  {id:'napper-2016',authors:'Napper & Thompson',year:2016,journal:'Marine Pollution Bulletin',doi:'10.1016/j.marpolbul.2016.09.025',finding:'An average 6 kg acrylic wash load was estimated to release over 700,000 fibres under the studied conditions.',limitation:'Not a universal per-wash emission factor.'},
  {id:'defalco-2019',authors:'De Falco et al.',year:2019,journal:'Scientific Reports',doi:'10.1038/s41598-019-43023-x',finding:'Measured release varied across tested synthetic garments, ranging from 124 to 308 mg per kg of washed fabric.',limitation:'Garment and protocol specific.'},
  {id:'kelly-2019',authors:'Kelly et al.',year:2019,journal:'Environmental Science & Technology',doi:'10.1021/acs.est.9b03022',finding:'In the tested first-wash comparison, a higher-water-volume delicate cycle released around 800,000 more fibres than a standard cycle.',limitation:'An experimental comparison, not a universal wash recommendation.'},
  {id:'gliaudelyte-2025',authors:'Gliaudelytė et al.',year:2025,journal:'Textile Research Journal',doi:'10.1177/00405175241260066',finding:'A review finds that fibre content, yarn construction, textile structure and treatments all affect fibre release.',limitation:'A literature review; effects are context-dependent.'},
  {id:'chem-2025',authors:'Critical review (2025)',year:2025,journal:'Chemosphere',doi:'10.1016/j.chemosphere.2025.144394',finding:'Different release-testing protocols and reporting units make results hard to compare.',limitation:'Reviews methods and evidence; not a cross-study prediction dataset.'},
];

const FIELD_NOTES = [
  {code:'FIELD NOTE / 1',kicker:'SCALE',large:'700,000+',unit:'fibres',title:'One acrylic wash load',description:'An estimated 6 kg acrylic wash load released more than 700,000 fibres in Napper & Thompson’s experimental conditions.',source:'Napper & Thompson · 2016',doi:'10.1016/j.marpolbul.2016.09.025',caution:'Estimate for an acrylic wash, not an average for all garments.'},
  {code:'FIELD NOTE / 2',kicker:'MATERIAL',large:'124–308',unit:'mg/kg',title:'Garments do not shed equally',description:'De Falco and colleagues measured this range of released fibre mass across the synthetic garments they tested.',source:'De Falco et al. · 2019',doi:'10.1038/s41598-019-43023-x',caution:'Study-specific garment and washing conditions.'},
  {code:'FIELD NOTE / 3',kicker:'WASH CONDITIONS',large:'+800k',unit:'fibres',title:'Delicate is not always lower-shedding',description:'In one first-wash comparison, a higher-water-volume delicate cycle released approximately 800,000 more fibres than a standard cycle.',source:'Kelly et al. · 2019',doi:'10.1021/acs.est.9b03022',caution:'A difference between tested cycles, not a universal rule.'},
  {code:'FIELD NOTE / 4',kicker:'RESEARCH GAP',large:'NO',unit:'universal unit',title:'Measurements can disagree',description:'Researchers report fibres per wash, mass per fabric weight and other measures. Comparing studies requires careful protocol checks.',source:'Chemosphere critical review · 2025',doi:'10.1016/j.chemosphere.2025.144394',caution:'Reporting heterogeneity is a methodological challenge.'},
];
const QUIZ = [
  {q:'Which statement about a “delicate” wash is best supported?',answers:['It always releases fewer microfibres','It always releases more microfibres','Water-to-fabric ratio can change release; results depend on conditions'],correct:2,why:'Kelly et al. found greater release in tested higher-water-volume delicate cycles. That does not prove every delicate cycle behaves alike.',source:'Kelly et al. (2019)',doi:'10.1021/acs.est.9b03022'},
  {q:'Why does FIBREPRINT record the fabric construction?',answers:['Because fibre composition alone cannot capture all shedding behaviour','Because woven fabrics never shed','Because construction determines colour'],correct:0,why:'A review identified yarn construction, textile structure and surface treatment alongside fibre type as relevant to release.',source:'Gliaudelytė et al. (2025)',doi:'10.1177/00405175241260066'},
  {q:'Can 124–308 mg/kg be used as the shedding rate of every polyester garment?',answers:['Yes, this is a global standard','No, it came from particular garments and tests','Yes, if the wash is cold'],correct:1,why:'De Falco et al. measured selected synthetic garments under particular laundering conditions. Transferring the result requires justification.',source:'De Falco et al. (2019)',doi:'10.1038/s41598-019-43023-x'},
  {q:'What is the responsible response if the model lacks compatible data?',answers:['Display a precise-looking estimate','Ask an LLM to guess a number','Mark numerical prediction as not validated'],correct:2,why:'The current FIBREPRINT prototype intentionally withholds release estimates until compatible observations and proper validation exist.',source:'FIBREPRINT scientific guardrails',doi:null},
  {q:'Are all textile microfibres automatically microplastics?',answers:['Yes, every small fibre is plastic','No, natural fibres can also shed','Only blue fibres are microplastics'],correct:1,why:'Microfibres describe size and shape. Microplastics refer to plastic material; natural textiles may shed nonplastic fibres.',source:'Material terminology',doi:null},
];
const GLOSSARY = [
 {term:'Microfibre',definition:'A very fine textile fibre or fibre fragment; not necessarily made of plastic.'},
 {term:'Microplastic',definition:'A small particle of plastic. Synthetic textile microfibres may be microplastics.'},
 {term:'GSM',definition:'Grams per square metre, a measure of the mass of a fabric per unit area.'},
 {term:'Liquor ratio',definition:'The water-to-fabric mass ratio in laundering; may affect fibre release.'},
 {term:'Prediction interval',definition:'An interval intended to describe uncertainty around a future individual observation.'},
 {term:'Protocol compatibility',definition:'Whether different studies measured comparable materials and conditions using sufficiently compatible methods.'},
];
function LabExtras(){
 const [fact,setFact]=useState(0),[quizIndex,setQuizIndex]=useState(0),[chosen,setChosen]=useState(null),[score,setScore]=useState(0),[completed,setCompleted]=useState(false),[openTerm,setOpenTerm]=useState('Microfibre');
 const note=FIELD_NOTES[fact],item=QUIZ[quizIndex];
 const choose=(i)=>{if(chosen!==null)return;setChosen(i);if(i===item.correct)setScore(n=>n+1)};
 const advance=()=>{if(quizIndex===QUIZ.length-1){setCompleted(true)}else{setQuizIndex(i=>i+1);setChosen(null)}};
 const reset=()=>{setQuizIndex(0);setChosen(null);setCompleted(false);setScore(0)};
 return <>
 <section id="field-notes" className="fieldnotes"><div className="studio-kicker">4 / THE FIELD NOTES <span>RESEARCH, WITHOUT THE JARGON</span></div><div className="field-intro"><div><h2>Small details. <em>Big consequences.</em></h2><p>Unexpected observations from actual laundering studies. Each one comes with its source and its limits.</p><div className="fp-field-chips"><span>4 peer-reviewed observations</span><span>Context over clickbait</span><span>Original DOI links</span></div></div><div className="facts-selector"><span>OBSERVATION {fact+1} / 4</span><div className="facts-dots">{FIELD_NOTES.map((n,i)=><button type="button" aria-label={'Read observation '+(i+1)} key={n.code} onClick={()=>setFact(i)} className={i===fact?'sel':''}>{i+1}</button>)}</div></div></div><div className="fact-stage" key={note.code}><div className="fact-index"><div className="fibre-glyph" aria-hidden="true"><span/><span/><span/><span/><span/></div><small>{note.code}</small><b>{note.kicker}</b></div><div className="fact-stat"><span className="stat-big">{note.large}</span><span className="stat-unit">{note.unit}</span></div><div className="fact-copy"><h3>{note.title}</h3><p>{note.description}</p><small>{note.caution}</small><div className="fp-fact-source">RESEARCH RECORD / {note.source}</div><a href={'https://doi.org/'+note.doi} target="_blank" rel="noopener noreferrer">Read the original study <ArrowUpRight size={16}/></a></div></div><div className="fact-navigator"><span>NO GUESSWORK. JUST GROUNDED OBSERVATIONS.</span><button onClick={()=>setFact(i=>(i+1)%FIELD_NOTES.length)}>Next field note <ArrowRight size={18}/></button></div></section>
 <section id="quiz" className="quizlab"><div className="studio-kicker">5 / THE MATERIAL QUIZ <span>INTERACTIVE RESEARCH CHALLENGE</span></div><div className="quiz-shell"><div className="quiz-aside"><div className="quiz-mini"><Lightbulb size={20}/> LEARNING IS AN EXPERIMENT</div><h2>THINK<br/><em>LIKE A LAB.</em></h2><p>Five quick questions. Each answer unlocks the reasoning and a research reference. No trick scores and no made-up science.</p><div className="quiz-progress-dots">{QUIZ.map((q,i)=><span key={i} className={i<=quizIndex?'filled':''}/>)}</div><div className="quiz-aside-bottom">FIBREPRINT / FIELD SCHOOL<br/>A MICRO-LESSON IN TEXTILE SCIENCE</div></div><div className="quiz-stage">
 {completed?<div className="quiz-finished"><BadgeCheck size={42}/><span>EXPERIMENT COMPLETE</span><h3>{score} / {QUIZ.length}</h3><p>You've completed the field questions. The evidence is always one click away, and the experiments remain more important than the score.</p><button className="quiz-next" onClick={reset}>Try again <RotateCcw size={17}/></button></div>:<><div className="quiz-counter"><span>QUESTION {quizIndex+1} / 5</span><span>{score} CORRECT SO FAR</span></div><h3>{item.q}</h3><div className="quiz-options">{item.answers.map((a,i)=><button key={i} onClick={()=>choose(i)} disabled={chosen!==null} className={chosen===null?'':i===item.correct?'correct':i===chosen?'incorrect':'muted'}><span>{String.fromCharCode(65+i)}</span>{a}<span className="answer-symbol">{chosen!==null&&i===item.correct?'✓':chosen===i&&chosen!==item.correct?'×':'↗'}</span></button>)}</div>{chosen!==null&&<div className="quiz-explanation"><strong>{chosen===item.correct?'THAT’S RIGHT.':'HERE’S THE SCIENCE.'}</strong><p>{item.why}</p>{item.doi?<a href={'https://doi.org/'+item.doi} target="_blank" rel="noopener noreferrer">Source: {item.source} <ArrowUpRight size={14}/></a>:<span>{item.source}</span>}<button className="quiz-next" onClick={advance}>{quizIndex===QUIZ.length-1?'See results':'Next question'} <ArrowRight size={17}/></button></div>}</>}
 </div></div></section>
 <section className="glossary" id="glossary"><div className="studio-kicker">6 / POCKET REFERENCE <span>A TEXTILE-SCIENCE GLOSSARY</span></div><div className="glossary-grid"><div className="fp-glossary-aside"><h2>Words <em>with weight.</em></h2><p>The small vocabulary of textile research, explained without losing the science.</p><div className="fp-glossary-stat"><strong>6</strong><span>terms worth knowing<br/>before your first experiment</span></div><div className="fp-glossary-key"><span>FIELD GUIDE / MATERIAL SCIENCE</span><p>Choose a term to open its definition. Each term connects to a real decision in the workbench.</p></div></div><div className="glossary-list">{GLOSSARY.map(x=><button className={openTerm===x.term?'gloss-item expanded':'gloss-item'} key={x.term} onClick={()=>setOpenTerm(t=>t===x.term?'':x.term)}><span className="gloss-term">{x.term}</span><span className="gloss-toggle">{openTerm===x.term?'−':'+'}</span>{openTerm===x.term&&<p>{x.definition}</p>}</button>)}</div></div></section>
 </>;
}

// Visual specimen archive: photographs are illustrative; chemistry and construction
// are not independently verified from images. Source pages are printed on every card.
const FABRIC_PHOTOS = [
  {id:'FP–101',name:'Denim / twill',detail:'Diagonal ribbing and dense woven texture',file:'/images/fabrics/denim.webp',source:'https://unsplash.com/photos/close-up-of-dark-blue-denim-fabric-texture-JT5SXO9hzJk',construction:'woven'},
  {id:'FP–102',name:'Jersey / knit',detail:'Looped textile surface',file:'/images/fabrics/jersey.webp',source:'https://www.pexels.com/photo/close-up-shot-of-a-knitted-textile-5806993/',construction:'knit'},
  {id:'FP–103',name:'Fleece / pile',detail:'Soft raised surface',file:'/images/fabrics/fleece.webp',source:'https://www.pexels.com/photo/soft-gray-fleece-fabric-texture-close-up-30399249/',construction:'fleece'},
  {id:'FP–104',name:'Plain woven / neutral',detail:'Interlaced fabric surface',file:'/images/fabrics/woven-cotton.webp',source:'https://www.pexels.com/photo/close-up-of-a-fabric-6979822/',construction:'woven'},
];

function SourceLink({url,light=false}) {
  return <a className={'fp-photo-source'+(light?' light':'')} href={url} target="_blank" rel="noopener noreferrer" title={url}>
    <span>PHOTO SOURCE</span><span className="fp-source-url">{url}</span><ArrowUpRight size={12} aria-hidden="true"/>
  </a>;
}

const initialFabric={name:'Specimen 1',primary_fibre:'polyester',construction:'knit',gsm:180,wash_count:1};
const initialWash={temperature_c:30,duration_min:45,water_l:40,load_mass_kg:'',measurement_method:'',cycle:'normal'};
const stepNames=['Describe the fabric','Set the wash','Inspect the evidence','Compare scenarios'];
const stepDescriptions=['Identify construction, fibre family and fabric weight.','Set the temperature, water volume and wash cycle.','Review study limits before making an estimate.','Inspect different settings side by side.'];
const fmt=v=>v===''?null:Number(v);

function App({user,token,onLogout}){
  const [fabric,setFabric]=useState(initialFabric),[wash,setWash]=useState(initialWash),[comparison,setComparison]=useState({...initialWash,temperature_c:40,water_l:30,cycle:'delicate'});
  const [passportIndex,setPassportIndex]=useState(null);
  const [modelInfo,setModelInfo]=useState(null);
  const [step,setStep]=useState(0),[sources,setSources]=useState(FALLBACK_SOURCES),[online,setOnline]=useState(false),[report,setReport]=useState(null),[csvReport,setCsvReport]=useState(null),[csvError,setCsvError]=useState(''),[mobileMenu,setMobileMenu]=useState(false);
  const setF=(key,value)=>{setFabric(f=>({...f,[key]:value}));setReport(null)};
  const setW=(key,value)=>{setWash(w=>({...w,[key]:value}));setReport(null)};
  useEffect(()=>{fetch('/api/health').then(r=>r.ok?setOnline(true):setOnline(false)).catch(()=>setOnline(false));fetch('/api/sources').then(r=>r.ok?r.json():Promise.reject()).then(j=>setSources(j.items)).catch(()=>{});fetch('/api/model/status',{headers:{'Authorization':'Bearer '+token}}).then(r=>r.ok?r.json():Promise.reject()).then(setModelInfo).catch(()=>{});},[]);
  const evaluate=async()=>{
    try {const res=await fetch('/api/evaluate',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({fabric:{...fabric,gsm:fmt(fabric.gsm),wash_count:fmt(fabric.wash_count)},wash:{...wash,temperature_c:Number(wash.temperature_c),duration_min:Number(wash.duration_min),water_l:fmt(wash.water_l),load_mass_kg:fmt(wash.load_mass_kg),measurement_method:wash.measurement_method||null}})}); if(!res.ok)throw new Error('Invalid profile. Check required input ranges.');setReport(await res.json());setOnline(true);setStep(2)}
    catch(e){setOnline(false);setReport({prediction:null,prediction_status:'OFFLINE',message:e.message+'. Start the FastAPI backend to run this check. The workspace remains editable.'});setStep(2)}
  };
  const validateCsv=async(file)=>{if(!file)return;setCsvError('');setCsvReport(null);const csv_text=await file.text();try{const res=await fetch('/api/validate-csv',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},body:JSON.stringify({csv_text})});if(!res.ok)throw Error('Could not validate CSV');setCsvReport(await res.json())}catch(e){setCsvError('Start the backend to validate CSV files. '+e.message)}};
  const scroll=(to)=>document.querySelector(to)?.scrollIntoView({behavior:'smooth',block:'start'});
  return <div className="site">
    <header className="topbar"><a className="brand" href="#top"><span className="brand-monogram">f<span className="slash">/</span>p</span><span className="brand-word">FIBREPRINT <small>MATERIAL INTELLIGENCE LAB</small></span></a><nav className={mobileMenu?'nav open':'nav'}><a href="#workbench" onClick={()=>setMobileMenu(false)}>The workbench</a><a href="#process" onClick={()=>setMobileMenu(false)}>Our process</a><a href="#textiles" onClick={()=>setMobileMenu(false)}>Textile atlas</a><a href="#evidence" onClick={()=>setMobileMenu(false)}>Evidence library</a><a href="#microscope" onClick={()=>setMobileMenu(false)}>Microscope</a><a href="#field-notes" onClick={()=>setMobileMenu(false)}>Field notes</a><a href="#quiz" onClick={()=>setMobileMenu(false)}>Mini quiz</a></nav><div className="top-actions"><span className="user-handle">{user?.name}</span><button className="logout-trigger" onClick={onLogout}>Sign out</button><span className={online?'connection connected':'connection'}><i/>{online?'API connected':'Local preview'}</span><button className="mobile-trigger" onClick={()=>setMobileMenu(!mobileMenu)} aria-label="Toggle menu">{mobileMenu?<X size={21}/>:<Menu size={21}/>}</button></div></header>
    <main id="top">
      <section className="hero"><div className="hero-top"><span>RESEARCH PREVIEW / 2026</span><span>1 — AN OPEN MATERIAL STUDY</span></div><div className="hero-grid"><div className="hero-copy"><div className="eyebrow"><span className="mini-mark"/> THE MATERIAL QUESTION</div><h1>EVERY FABRIC<br/>LEAVES <em>A TRACE.</em></h1><p>How much does a textile shed when we wash it? Explore the material properties, washing conditions and scientific evidence behind that question.</p><div className="hero-buttons"><button className="primary" onClick={()=>scroll('#workbench')}>Enter the lab <ArrowUpRight size={18}/></button><button className="textbutton" onClick={()=>scroll('#evidence')}>Explore the research <ArrowRight size={17}/></button></div></div><div className="hero-art fp-hero-photo" aria-label="Editorial photograph showing textile textures"><img src="/images/hero/textile-editorial.webp" alt="Close-up editorial photograph of folded textile textures" onError={e=>{e.currentTarget.style.opacity='0'}}/><div className="fp-hero-photo-label">TEXTILE ARCHIVE / 1 <span>FABRIC STUDY</span></div><SourceLink url="https://unsplash.com/photos/NA_lOSxbQHY" light/></div></div><div className="hero-foot"><span><Microscope size={16}/> EVIDENCE BEFORE ESTIMATES</span><span>AN EARLY-STAGE RESEARCH PRODUCT <ArrowRight size={15}/></span></div></section>
      <section id="process" className="process"><div className="section-index">1 / HOW IT WORKS</div><div className="fp-process-heading"><div><h2>From fabric <em>to findings.</em></h2><p className="section-intro">An experimental process with a purpose. Four steps, each grounded in a real material question.</p></div><div className="fp-process-badge"><span>THE LAB METHOD</span><strong>4</strong><small>connected stages</small></div></div><div className="process-line">{stepNames.map((name,i)=><button key={name} className={'process-node '+(i===step?'active':'')} onClick={()=>{setStep(i);scroll('#workbench')}}><span className="node-num">{i+1}</span><strong>{name}</strong><small className="fp-node-detail">{stepDescriptions[i]}</small><span className="node-arrow"><ArrowUpRight size={16}/></span></button>)}</div><div className="fp-process-foot"><span>OBSERVE → CONFIGURE → QUESTION → COMPARE</span><span>Tap any stage to enter the workbench <ArrowUpRight size={14}/></span></div></section>
      <section className="fp-textile-atlas" id="textiles">
  <div className="fp-atlas-heading"><div><div className="section-index">1B / FABRIC SPECIMEN ARCHIVE</div><h2>TOUCH THE<br/><em>TEXTURE.</em></h2></div><p>Meet four illustrative textile surfaces. Select a construction to begin an investigation; the photographs illustrate textures, not laboratory-verified fibre composition or shedding rates.</p></div>
  <div className="fp-atlas-grid">{FABRIC_PHOTOS.map((item,i)=><article className="fp-atlas-card" key={item.id}>
    <div className="fp-atlas-img"><img loading="lazy" src={item.file} alt={`${item.name}: ${item.detail}`} onError={e=>{e.currentTarget.style.opacity='0'}}/><span>{item.id}</span></div>
    <SourceLink url={item.source}/>
    <div className="fp-atlas-description"><div><small>SPECIMEN / {i+1}</small><h3>{item.name}</h3><p>{item.detail}</p></div><button type="button" aria-label={`Open material passport for ${item.name}`} onClick={()=>setPassportIndex(i)}><ArrowUpRight size={20}/></button></div>
  </article>)}</div>
  <p className="fp-atlas-passport-tip">SELECT THE ARROW ON ANY SPECIMEN TO OPEN ITS MATERIAL PASSPORT <ArrowUpRight size={15}/></p>
  <p className="fp-atlas-caveat">Visual references only · Source pages and photographic credits are shown beneath each image · Not a material-identification assay.</p>
</section>
      <section id="workbench" className="workbench"><div className="workbench-head"><div><div className="section-index">2 / THE WORKBENCH</div><h2>Your next <em>material experiment.</em></h2><p className="fp-workbench-intro">A guided workbench for describing textiles, exploring wash settings and tracing what the evidence can actually support.</p></div><div className="workbench-side">SPECIMEN NO. 1<br/>STATUS / EXPLORATORY<br/>OUTPUT / NOT YET VALIDATED</div></div><div className="workbench-grid"><aside className="stepnav">{stepNames.map((s,i)=><button className={i===step?'selected':''} key={s} onClick={()=>setStep(i)}><b>{i+1}</b><span>{s}</span><ArrowUpRight size={16}/></button>)}<p>Prototype measurements and wash parameters are user inputs; they are not experimental observations.</p></aside><div className="panel">
        {step===0&&<><div className="panel-top"><span className="spec-label">STUDY / MATERIAL PROFILE</span><span className="panel-state">1 / 4</span></div><h3>Begin with the textile.</h3><p className="panel-help">The fabric itself matters: fibre chemistry, construction and prior use can influence release.</p><div className="formgrid"><label className="full">Specimen name<input value={fabric.name} maxLength={90} onChange={e=>setF('name',e.target.value)}/></label><label>Primary fibre<select value={fabric.primary_fibre} onChange={e=>setF('primary_fibre',e.target.value)}>{['polyester','cotton','acrylic','polyamide','blend','other'].map(v=><option key={v} value={v}>{v[0].toUpperCase()+v.slice(1)}</option>)}</select></label><label>Construction<select value={fabric.construction} onChange={e=>setF('construction',e.target.value)}>{['knit','woven','fleece','unknown'].map(v=><option key={v} value={v}>{v[0].toUpperCase()+v.slice(1)}</option>)}</select></label><label>Fabric weight (GSM)<input type="number" min="1" max="1500" value={fabric.gsm} onChange={e=>setF('gsm',e.target.value)}/></label><label>Previous washes<input type="number" min="0" max="1000" value={fabric.wash_count} onChange={e=>setF('wash_count',e.target.value)}/></label></div><div className="panel-actions"><span>1 / PROFILE</span><button className="primary dark" onClick={()=>setStep(1)}>Set washing conditions <ArrowRight size={16}/></button></div></>}
        {step===1&&<><div className="panel-top"><span className="spec-label">STUDY / WASH SETTINGS</span><span className="panel-state">2 / 4</span></div><h3>Set the conditions.</h3><p className="panel-help">Choose the scenario you would like to investigate. Values below are inputs, not predictions.</p><div className="formgrid"><label>Cycle<select value={wash.cycle} onChange={e=>setW('cycle',e.target.value)}>{['normal','delicate','heavy'].map(v=><option key={v}>{v}</option>)}</select></label><label>Temperature (°C)<input type="number" min="0" max="95" value={wash.temperature_c} onChange={e=>setW('temperature_c',e.target.value)}/></label><label>Duration (minutes)<input type="number" min="1" max="360" value={wash.duration_min} onChange={e=>setW('duration_min',e.target.value)}/></label><label>Water volume (L)<input type="number" min="1" max="400" value={wash.water_l} onChange={e=>setW('water_l',e.target.value)}/></label><label>Fabric load mass (kg)<input type="number" min="0.01" max="30" step="0.01" placeholder="Enter measured mass" value={wash.load_mass_kg} onChange={e=>setW('load_mass_kg',e.target.value)}/></label><label>Measurement protocol (only if documented)<select value={wash.measurement_method} onChange={e=>setW('measurement_method',e.target.value)}><option value="">Not confirmed</option><option value="gravimetric">Gravimetric mass collection</option><option value="particle_count_converted_with_verified_mass">Validated count-to-mass conversion</option><option value="other_documented_mass_method">Other documented mass method</option></select></label></div><div className="field-note"><CircleHelp size={17}/> Actual water-to-fabric ratio requires both load mass and water volume. This first scaffold captures water volume only.</div><div className="panel-actions"><button className="textbutton" onClick={()=>setStep(0)}>Back</button><button className="primary dark" onClick={evaluate}>Inspect evidence readiness <ArrowRight size={16}/></button></div></>}
        {step===2&&<><div className="panel-top"><span className="spec-label">STUDY / RESEARCH EVIDENCE</span><span className="panel-state">3 / 4</span></div><h3>Where evidence ends.</h3><p className="panel-help">A useful scientific tool must also say when it cannot support a numerical answer.</p><div className="no-prediction"><div className="no-prediction-mark">—</div><div><span>MODEL STATUS</span><strong>{report?.prediction_status==='OFFLINE'?'BACKEND NOT CONNECTED':report?.prediction_status==='MODEL_ESTIMATE'?'VALIDATED-DOMAIN ESTIMATE':(report?.prediction_status==='NOT_TRAINED'?'RESEARCH ONLY — NO SERVING MODEL':(report?.prediction_status||'NOT YET VALIDATED').replaceAll('_',' '))}</strong><p>{report?.message||'No validated numerical shedding estimate is currently available. A source-curated dataset and independent held-out evaluation are required.'}</p></div></div>{report?.prediction_status==='MODEL_ESTIMATE'&&<div className="fp-model-result"><strong>{report.prediction} mg/kg fabric</strong><span>{report.interval?.join('–')} mg/kg · {report.interval_label}</span></div>}{report?.model_info?.metrics&&<div className="fp-model-metrics"><strong>Research model / held-out evidence</strong><span>MAE {report.model_info.metrics.test_mae_mg_per_kg?.toFixed(2)} mg/kg · Median baseline MAE {report.model_info.metrics.baseline_test_mae_mg_per_kg?.toFixed(2)} mg/kg</span><small>{report.model_info.data_scope?.unique_studies} studies · {report.model_info.data_scope?.rows} measurements · {report.model_info.metrics.split_by}-group split</small></div>}{report?.missing_context?.length>0&&<div className="missing"><strong>Missing context</strong>{report.missing_context.map(m=><span key={m}>• {m}</span>)}</div>}<div className="panel-actions"><button className="textbutton" onClick={()=>setStep(1)}>Adjust washing conditions</button><button className="primary dark" onClick={()=>setStep(3)}>Compare scenarios <ArrowRight size={16}/></button></div></>}
        {step===3&&<><div className="panel-top"><span className="spec-label">STUDY / SCENARIO LAB</span><span className="panel-state">4 / 4</span></div><h3>Compare, don't guess.</h3><p className="panel-help">A side-by-side view of configured washes. Estimated release will appear only after model validation.</p><div className="compare-grid"><div><b>SCENARIO A</b><span>{wash.cycle}</span><small>{wash.temperature_c}°C · {wash.water_l||'—'} L · {wash.duration_min} min</small></div><div><b>SCENARIO B</b><label>Cycle<select value={comparison.cycle} onChange={e=>setComparison({...comparison,cycle:e.target.value})}>{['normal','delicate','heavy'].map(v=><option key={v}>{v}</option>)}</select></label><label>Temperature (°C)<input type="number" value={comparison.temperature_c} onChange={e=>setComparison({...comparison,temperature_c:e.target.value})}/></label><label>Water (L)<input type="number" value={comparison.water_l} onChange={e=>setComparison({...comparison,water_l:e.target.value})}/></label></div></div><div className="result-row"><span>Predicted release / A</span><strong>Awaiting validation</strong></div><div className="result-row"><span>Predicted release / B</span><strong>Awaiting validation</strong></div><div className="result-row"><span>Reduction estimate</span><strong>Not claimed</strong></div><div className="panel-actions"><button className="textbutton" onClick={()=>setStep(1)}>Edit first scenario</button><button className="primary dark" onClick={()=>scroll('#evidence')}>View source papers <ArrowUpRight size={16}/></button></div></>}
      </div></div></section>
      <section id="evidence" className="evidence"><div className="section-index">3 / RESEARCH LEDGER</div><div className="evidence-head"><h2>TRACEABLE BY<br/><em>DESIGN.</em></h2><p>Browse the original studies and reviews. Each finding comes with its experimental limits — these papers are references, not a pre-trained prediction model.</p></div><div className="source-list">{sources.map((src,i)=><a key={src.id} href={'https://doi.org/'+src.doi} target="_blank" rel="noreferrer" className="source"><div className="source-num">{i+1}</div><div><span>{src.authors} / {src.year}</span><h3>{src.title||src.journal}</h3><span className="journal-name">{src.journal}</span><p>{src.finding}</p><small>LIMITATION — {src.limitation}</small><span className="doi-line">DOI / {src.doi}</span></div><ArrowUpRight size={22}/></a>)}</div><ResearchStatus token={token}/><div className="csv-area"><div><span>DATA CURATION / TOOL 1</span><h3>Bring your own observations.</h3><p>Check that a CSV has the expected columns. Schema validation is not scientific validation, and the file is not stored on the server.</p></div><label className="upload"><Upload size={20}/> Choose a CSV<input type="file" accept=".csv,text/csv" onChange={e=>validateCsv(e.target.files?.[0])}/></label>{csvReport&&<div className="csv-msg">{csvReport.valid?'✓ Schema accepted':'! Schema needs attention'} · {csvReport.row_count} rows · {csvReport.missing_columns.length} missing columns {csvReport.problems.length>0?' · '+csvReport.problems.slice(0,2).join('; '):''}</div>}{csvError&&<div className="csv-msg">{csvError}</div>}</div></section>
      <ResearchResults/><ExternalEvidence/><MicroscopeExplorer/><LabExtras/><section className="footer-cta"><span>THE STUDY CONTINUES.</span><h2>MEASURE CAREFULLY.<br/><em>PREDICT RESPONSIBLY.</em></h2><button className="primary" onClick={()=>scroll('#workbench')}>Back to the lab <ArrowUpRight size={18}/></button></section>
    </main>{passportIndex!==null&&<MaterialPassport specimens={FABRIC_PHOTOS} selectedIndex={passportIndex} onClose={()=>setPassportIndex(null)} onInvestigate={specimen=>{setF('construction',specimen.construction);setF('name',specimen.name+' study');setStep(0);setPassportIndex(null);requestAnimationFrame(()=>document.querySelector('#workbench')?.scrollIntoView({behavior:'smooth',block:'start'}))}}/>}<footer><span>FIBREPRINT / MATERIAL INTELLIGENCE LAB</span><span>CONCEPT PROTOTYPE · DATA-VALIDATION PHASE</span><span>RESEARCH WITH RECEIPTS. / V0.19</span></footer>
  </div>;
}
export default App;
